# ==============================================================================
# RetailPulse Data Engineering Platform - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Replace all placeholder values (<...>) with your actual project configurations.
# 3. NEVER commit your actual '.env' file or service account credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General & Application Environment
# ------------------------------------------------------------------------------
APP_ENV=development                       # Options: development, staging, production
LOG_LEVEL=INFO                            # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
TIMEZONE=UTC

# ------------------------------------------------------------------------------
# 2. PostgreSQL (OLTP E-Commerce Source Database)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=retailpulse
POSTGRES_USER=retailpulse_user
POSTGRES_PASSWORD=<your_secure_postgres_password>
POSTGRES_SCHEMA=public

# ------------------------------------------------------------------------------
# 3. Google Cloud Platform (Core Configuration)
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=<your_gcp_project_id>
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
# Absolute or relative path to your service account key JSON file
GOOGLE_APPLICATION_CREDENTIALS=infrastructure/secrets/gcp-service-account.json

# ------------------------------------------------------------------------------
# 4. Google Cloud Storage & Batch Ingestion Staging
# ------------------------------------------------------------------------------
GCS_BUCKET_LANDING=<your_gcp_project_id>-retailpulse-landing
GCS_BUCKET_RAW=<your_gcp_project_id>-retailpulse-bronze
GCS_BUCKET_PROCESSED=<your_gcp_project_id>-retailpulse-silver
GCS_BUCKET_DATALAKE_CODE=<your_gcp_project_id>-retailpulse-scripts
GCS_RAW_PREFIX=raw
LOCAL_STAGING_DIR=data/staging
BATCH_INGESTION_TABLES=customers,products,orders,order_items,payments

# ------------------------------------------------------------------------------
# 5. Google Cloud BigQuery (Data Warehouse Datasets)
# ------------------------------------------------------------------------------
BQ_DATASET_RAW=retailpulse_raw
BQ_DATASET_STAGING=retailpulse_staging
BQ_DATASET_MARTS=retailpulse_marts
BQ_LOCATION=US

# ------------------------------------------------------------------------------
# 6. Google Cloud Pub/Sub (Real-Time Ingestion)
# ------------------------------------------------------------------------------
PUBSUB_TOPIC_CLICKSTREAM=retailpulse-clickstream-events
PUBSUB_TOPIC_ORDERS=retailpulse-order-events
PUBSUB_SUBSCRIPTION_CLICKSTREAM=retailpulse-clickstream-sub
PUBSUB_SUBSCRIPTION_ORDERS=retailpulse-order-sub

# ------------------------------------------------------------------------------
# 7. Google Cloud Dataflow (Stream / Batch Processing)
# ------------------------------------------------------------------------------
DATAFLOW_TEMP_LOCATION=gs://<your_gcp_project_id>-retailpulse-landing/temp
DATAFLOW_STAGING_LOCATION=gs://<your_gcp_project_id>-retailpulse-landing/staging
DATAFLOW_MAX_WORKERS=5
DATAFLOW_MACHINE_TYPE=n1-standard-2

# ------------------------------------------------------------------------------
# 8. PySpark & Google Cloud Dataproc
# ------------------------------------------------------------------------------
SPARK_APP_NAME=RetailPulseBatchETL
DATAPROC_CLUSTER_NAME=retailpulse-spark-cluster
DATAPROC_REGION=us-central1

# ------------------------------------------------------------------------------
# 9. dbt (Data Build Tool)
# ------------------------------------------------------------------------------
DBT_PROFILES_DIR=./transformations/dbt
DBT_TARGET=dev

# ------------------------------------------------------------------------------
# 10. Apache Airflow / Google Cloud Composer
# ------------------------------------------------------------------------------
AIRFLOW_HOME=./orchestration/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
COMPOSER_ENVIRONMENT_NAME=retailpulse-composer
